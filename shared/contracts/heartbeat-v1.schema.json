{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Order Recorder Heartbeat v1",
  "type": "object",
  "required": [
    "source",
    "platform"
  ],
  "properties": {
    "source": {
      "type": "string"
    },
    "platform": {
      "enum": [
        "grab",
        "grabfood",
        "shopeefood",
        "shopee",
        "spf"
      ]
    },
    "deviceName": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "pending": {
      "type": "integer",
      "minimum": 0
    },
    "version": {
      "type": "string"
    }
  },
  "additionalProperties": true
}